@page "/documents/upload"
@inject QmsApiService ApiService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="container-fluid px-4 px-lg-5 py-4">
    <!-- Header Halaman & Tombol Kembali -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <i class="fa fa-cloud-upload-alt text-danger"></i>
                <span>Upload Dokumen Mutu Baru</span>
            </h4>
            <p class="text-muted small mb-0">Tambahkan berkas Pedoman, TKO, TKI, atau Format Mutu baru ke dalam sistem pengarsipan.</p>
        </div>
        <NavLink href="documents" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold small">
            <i class="fa fa-arrow-left me-2"></i>Kembali ke Daftar
        </NavLink>
    </div>

    @if (!isAdminChecked)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status"></div>
            <p class="text-muted small mt-2">Memeriksa hak akses...</p>
        </div>
    }
    else if (!isAdmin)
    {
        <div class="alert alert-warning rounded-4 p-4 text-center">
            <i class="fa fa-exclamation-triangle fs-2 text-warning mb-2 d-block"></i>
            <h5 class="fw-bold">Akses Terbatas</h5>
            <p class="mb-3">Fitur upload dokumen mutu hanya dapat diakses oleh Administrator.</p>
            <NavLink href="documents" class="btn btn-danger rounded-pill px-4">Kembali ke Dokumen</NavLink>
        </div>
    }
    else
    {
        <!-- Form Upload Container -->
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger rounded-3 alert-dismissible fade show mb-4" role="alert">
                            <strong>Perhatian:</strong> @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                        </div>
                    }

                    <EditForm Model="@uploadModel" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <!-- Nama Berkas -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-dark">Nama Berkas / Judul File <span class="text-danger">*</span></label>
                            <InputText @bind-Value="uploadModel.FileName" class="form-control rounded-3" placeholder="Contoh: PEDOMAN-MUTU-RU2-2026.pdf" />
                        </div>

                        <!-- Kategori / Master Menu -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-dark">Kategori Menu Mutu <span class="text-danger">*</span></label>
                            <select class="form-select rounded-3" @bind="uploadModel.MenuId">
                                @foreach (var m in menuList)
                                {
                                    <option value="@m.MenuId">@m.Menu - @m.Submenu</option>
                                }
                            </select>
                        </div>

                        <!-- Ukuran & Format File -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark">Ukuran Berkas</label>
                                <InputText @bind-Value="uploadModel.Size" class="form-control rounded-3" placeholder="Contoh: 2.4 MB" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark">Tipe MIME</label>
                                <InputText @bind-Value="uploadModel.Type" class="form-control rounded-3" placeholder="application/pdf" />
                            </div>
                        </div>

                        <hr class="my-4 text-muted opacity-25" />

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold shadow-sm" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Menyimpan ke API...</span>
                                }
                                else
                                {
                                    <i class="fa fa-cloud-upload-alt me-2"></i>
                                    <span>Simpan &amp; Upload Dokumen</span>
                                }
                            </button>
                            <NavLink href="documents" class="btn btn-light rounded-pill px-4 text-secondary">
                                Batal
                            </NavLink>
                        </div>
                    </EditForm>
                </div>
            </div>

            <!-- Panel Informasi / Ketentuan Upload -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
                    <h6 class="fw-bold text-dark mb-3"><i class="fa fa-info-circle text-danger me-2"></i>Ketentuan Pengunggahan</h6>
                    <ul class="text-muted small ps-3 mb-0 d-flex flex-column gap-2">
                        <li>Dokumen yang diunggah akan otomatis tersimpan di database <strong>QMS API</strong>.</li>
                        <li>Gunakan penamaan nomor/kode dokumen sesuai standar penomoran RU II Dumai.</li>
                        <li>Format berkas yang direkomendasikan adalah <strong>PDF</strong> untuk menjaga kerapian tata letak.</li>
                        <li>Dokumen yang disimpan akan langsung tampil di daftar Dokumen Mutu.</li>
                    </ul>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private TbUpload uploadModel = new() { FileName = "", Size = "1.5 MB", Type = "application/pdf", MenuId = 1, Creator = "admin" };
    private List<TbMenu> menuList = new();
    private bool isAdmin = false;
    private bool isAdminChecked = false;
    private bool isSubmitting = false;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var role = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userRole") ?? "User";
            isAdmin = role.Equals("Administrator", StringComparison.OrdinalIgnoreCase) || role.Equals("Admin", StringComparison.OrdinalIgnoreCase);
            isAdminChecked = true;

            menuList = await ApiService.GetMenusAsync();
            if (menuList.Any())
            {
                uploadModel.MenuId = menuList.First().MenuId;
            }

            StateHasChanged();
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(uploadModel.FileName))
        {
            errorMessage = "Nama berkas / dokumen tidak boleh kosong!";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var success = await ApiService.CreateDocumentAsync(uploadModel);
            if (success)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Dokumen mutu berhasil diupload ke database!");
                Navigation.NavigateTo("documents");
            }
            else
            {
                errorMessage = "Gagal mengunggah dokumen ke API backend.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
