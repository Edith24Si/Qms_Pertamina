@code {
    private bool isAdmin = false;
    private bool isLoading = true;
    private bool isSubmitting = false;

    private List<DocumentDto> allDocuments = new();
    private List<TbMenu> menuList = new();

    private string searchQuery = string.Empty;
    private int selectedMenuId = 0;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 12;

    // Modals
    private bool showAddModal = false;
    private bool showEditModal = false;
    private bool showViewModal = false;
    private bool showDeleteModal = false;

    private TbUpload newDoc = new();
    private TbUpload? editingDoc;
    private DocumentDto? viewingDoc;
    private DocumentDto? deletingDoc;

    // Alert
    private string alertMessage = string.Empty;
    private string alertType = "success";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var role = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userRole");
                isAdmin = (role == "Administrator");
                StateHasChanged();
            }
            catch {}
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            menuList = await ApiService.GetMenusAsync();
            allDocuments = await ApiService.GetDocumentsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading documents: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<DocumentDto> FilteredDocuments
    {
        get
        {
            var q = allDocuments.AsEnumerable();

            if (selectedMenuId > 0)
            {
                q = q.Where(d => d.MenuId == selectedMenuId);
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var s = searchQuery.Trim().ToLower();
                q = q.Where(d => d.FileName.ToLower().Contains(s) ||
                                 d.Creator.ToLower().Contains(s) ||
                                 d.Category.ToLower().Contains(s) ||
                                 d.Submenu.ToLower().Contains(s));
            }

            return q.ToList();
        }
    }

    private List<DocumentDto> PagedDocuments =>
        FilteredDocuments.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    private int TotalPages => (int)Math.Ceiling((double)FilteredDocuments.Count / pageSize);

    private void OnMenuChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int mid))
        {
            selectedMenuId = mid;
            currentPage = 1;
        }
    }

    private string FormatFileSize(string sizeStr)
    {
        if (long.TryParse(sizeStr, out long bytes))
        {
            if (bytes >= 1048576)
                return $"{(bytes / 1048576.0):0.1f} MB";
            if (bytes >= 1024)
                return $"{(bytes / 1024.0):0.1f} KB";
            return $"{bytes} B";
        }
        return sizeStr;
    }

    // Modal Actions
    private void OpenAddModal()
    {
        newDoc = new TbUpload
        {
            Creator = "admin",
            Type = "application/pdf",
            Size = "1500000"
        };
        showAddModal = true;
    }

    private async Task HandleSaveNewDoc()
    {
        isSubmitting = true;
        var success = await ApiService.CreateDocumentAsync(newDoc);
        isSubmitting = false;

        if (success)
        {
            showAddModal = false;
            alertType = "success";
            alertMessage = $"Dokumen '{newDoc.FileName}' berhasil ditambahkan ke database!";
            await LoadDataAsync();
        }
        else
        {
            alertType = "danger";
            alertMessage = "Gagal menyimpan dokumen baru ke server.";
        }
    }

    private void OpenEditModal(DocumentDto doc)
    {
        editingDoc = new TbUpload
        {
            UploadId = doc.UploadId,
            MenuId = doc.MenuId,
            Creator = doc.Creator,
            FileName = doc.FileName,
            FileDir = doc.FileDir,
            Size = doc.Size,
            Type = doc.Type
        };
        showEditModal = true;
    }

    private async Task HandleSaveEditDoc()
    {
        if (editingDoc == null) return;
        isSubmitting = true;
        var success = await ApiService.UpdateDocumentAsync(editingDoc.UploadId, editingDoc);
        isSubmitting = false;

        if (success)
        {
            showEditModal = false;
            alertType = "success";
            alertMessage = $"Dokumen #{editingDoc.UploadId} berhasil diperbarui!";
            await LoadDataAsync();
        }
        else
        {
            alertType = "danger";
            alertMessage = "Gagal memperbarui data dokumen.";
        }
    }

    private void OpenViewModal(DocumentDto doc)
    {
        viewingDoc = doc;
        showViewModal = true;
    }

    private void OpenDeleteConfirm(DocumentDto doc)
    {
        deletingDoc = doc;
        showDeleteModal = true;
    }

    private async Task ConfirmDeleteDoc()
    {
        if (deletingDoc == null) return;
        isSubmitting = true;
        var success = await ApiService.DeleteDocumentAsync(deletingDoc.UploadId);
        isSubmitting = false;

        if (success)
        {
            showDeleteModal = false;
            alertType = "success";
            alertMessage = $"Dokumen #{deletingDoc.UploadId} '{deletingDoc.FileName}' berhasil dihapus!";
            await LoadDataAsync();
        }
        else
        {
            alertType = "danger";
            alertMessage = "Gagal menghapus dokumen.";
        }
    }
}
