@page "/kkep/{menu}"
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<div class="container-fluid px-4 py-4">

    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="dashboard" class="text-decoration-none text-danger">Home</a></li>
                    <li class="breadcrumb-item text-muted">KKEP-PQA</li>
                    <li class="breadcrumb-item active text-capitalize">@GetTitle()</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-dark">
                KKEP-PQA: <span class="text-danger">@GetTitle()</span>
            </h4>
            <p class="text-muted small mb-0">Kelola dan pantau seluruh berkas & data @GetTitle() Pertamina RU II Dumai.</p>
        </div>

        @if (isAdmin)
        {
            <button class="btn btn-danger rounded-pill px-3 shadow-sm fw-semibold" @onclick="OpenAddModal">
                <i class="fa fa-plus-circle me-1"></i> Tambah Data @GetTitle()
            </button>
        }
    </div>

    <!-- Filter & Search Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="fa fa-search"></i>
                        </span>
                        <input type="text" class="form-control border-start-0 ps-0" 
                               placeholder="Cari judul, nomor dokumen, atau kata kunci..." 
                               @bind="searchQuery" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    <span class="badge bg-light text-dark border p-2 fw-normal w-100">
                        Total Data: <strong>@FilteredList.Count()</strong>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3 px-4">
            <h6 class="fw-bold text-dark mb-0">
                <i class="fa fa-folder-open text-danger me-2"></i>Daftar Record - @GetTitle()
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="small text-uppercase text-secondary">
                            <th class="ps-4 py-3">No</th>
                            <th class="py-3">Nomor Ref / Kode</th>
                            <th class="py-3">Judul Dokumen / Perihal</th>
                            <th class="py-3">Tanggal Update</th>
                            <th class="py-3">Status</th>
                            <th class="text-end pe-4 py-3">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredList.Any())
                        {
                            int no = 1;
                            @foreach (var item in FilteredList)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@(no++)</td>
                                    <td><span class="badge bg-secondary-subtle text-dark font-monospace">@item.Kode</span></td>
                                    <td class="fw-semibold text-dark">@item.Judul</td>
                                    <td class="small text-muted">@item.Tanggal.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="badge @(item.Status == "Selesai" || item.Status == "Verified" ? "bg-success" : "bg-warning text-dark")">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-1">
                                            <button class="btn btn-sm btn-outline-info rounded-pill px-3" @onclick="() => ViewPdf(item.PdfUrl)">
                                                <i class="fa fa-eye me-1"></i> Lihat
                                            </button>

                                            @if (isAdmin)
                                            {
                                                <a href="@item.PdfUrl" download class="btn btn-sm btn-outline-primary rounded-circle" title="Unduh">
                                                    <i class="fa fa-download"></i>
                                                </a>
                                                <button class="btn btn-sm btn-outline-secondary rounded-circle" @onclick="() => DeleteItem(item)" title="Hapus">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fa fa-inbox fs-1 d-block opacity-50 mb-2"></i>
                                    Belum ada data untuk menu <strong>@GetTitle()</strong>.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL TAMBAH DATA (Admin Only) -->
@if (showAddModal && isAdmin)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0 bg-danger text-white rounded-top-4">
                    <h5 class="modal-header-title fw-bold mb-0">
                        <i class="fa fa-plus-circle me-2"></i>Tambah Data @GetTitle()
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAddModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Nomor Ref / Kode *</label>
                            <input type="text" class="form-control" placeholder="Contoh: REF-2026-001" @bind="newItem.Kode" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Status</label>
                            <select class="form-select" @bind="newItem.Status">
                                <option value="Diproses">Diproses</option>
                                <option value="Verified">Verified</option>
                                <option value="Selesai">Selesai</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-secondary">Judul Dokumen / Perihal *</label>
                            <input type="text" class="form-control" placeholder="Masukkan judul dokumen" @bind="newItem.Judul" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-secondary">Lampiran Dokumen (PDF)</label>
                            <input type="file" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CloseAddModal">Batal</button>
                    <button type="button" class="btn btn-danger rounded-pill px-4" @onclick="SaveData">Simpan Data</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL VIEWER PDF -->
@if (showPdfModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6); z-index: 1050;">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="fa fa-file-pdf text-danger me-2"></i> Viewer Dokumen KKEP-PQA
                    </h5>
                    <button type="button" class="btn-close" @onclick="ClosePdfModal"></button>
                </div>
                <div class="modal-body p-0">
                    <iframe src="@($"{selectedPdfUrl}#toolbar=0&navpanes=0")" width="100%" height="650px" style="border: none;"></iframe>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" @onclick="ClosePdfModal">Tutup</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string? menu { get; set; }

    private bool isAdmin = false;
    private string userRole = "User";

    private string searchQuery = "";
    private List<KkepItem> dataList = new();

    private bool showAddModal = false;
    private bool showPdfModal = false;
    private string selectedPdfUrl = "";
    private KkepItem newItem = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            userRole = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userRole") ?? "User";
            isAdmin = userRole.Equals("Administrator", StringComparison.OrdinalIgnoreCase) || 
                      userRole.Equals("Admin", StringComparison.OrdinalIgnoreCase);
            StateHasChanged();
        }
    }

    protected override void OnParametersSet()
    {
        LoadDataForCurrentMenu();
    }

    private string GetTitle()
    {
        return menu?.ToLower() switch
        {
            "ofi-to-afi" => "OFI to AFI",
            "evidence" => "Evidence",
            "buku-kkep" => "Buku KKEP",
            "score" => "Score KKEP-PQA",
            _ => "KKEP-PQA"
        };
    }

    private IEnumerable<KkepItem> FilteredList =>
        dataList.Where(d => string.IsNullOrEmpty(searchQuery) ||
                            d.Judul.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                            d.Kode.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private void LoadDataForCurrentMenu()
    {
        searchQuery = "";
        var currentMenu = menu?.ToLower() ?? "";

        if (currentMenu == "ofi-to-afi")
        {
            dataList = new List<KkepItem>
            {
                new KkepItem { Kode = "OFI-2026-001", Judul = "Tindak Lanjut Evaluasi Temuan Pompa Kilang Area 2", Tanggal = DateTime.Now.AddDays(-3), Status = "Diproses", PdfUrl = "assets/docs/sample.pdf" },
                new KkepItem { Kode = "OFI-2026-002", Judul = "AFI Rekomendasi Audit Internal HSSE", Tanggal = DateTime.Now.AddDays(-10), Status = "Selesai", PdfUrl = "assets/docs/sample.pdf" }
            };
        }
        else if (currentMenu == "evidence")
        {
            dataList = new List<KkepItem>
            {
                new KkepItem { Kode = "EVD-2026-101", Judul = "Evidence Verifikasi Sertifikasi ISO 9001:2015", Tanggal = DateTime.Now.AddDays(-5), Status = "Verified", PdfUrl = "assets/docs/sample.pdf" },
                new KkepItem { Kode = "EVD-2026-102", Judul = "Bukti Foto & Berita Acara Kalibrasi Peralatan", Tanggal = DateTime.Now.AddDays(-12), Status = "Diproses", PdfUrl = "assets/docs/sample.pdf" }
            };
        }
        else if (currentMenu == "buku-kkep")
        {
            dataList = new List<KkepItem>
            {
                new KkepItem { Kode = "BK-2026-01", Judul = "Buku Pedoman KKEP Edisi 2026 (Final Version)", Tanggal = DateTime.Now.AddDays(-20), Status = "Selesai", PdfUrl = "assets/docs/sample.pdf" }
            };
        }
        else if (currentMenu == "score")
        {
            dataList = new List<KkepItem>
            {
                new KkepItem { Kode = "SCR-2026-Q3", Judul = "Rekapitulasi Scoring KKEP Triwulan III", Tanggal = DateTime.Now.AddDays(-1), Status = "Verified", PdfUrl = "assets/docs/sample.pdf" }
            };
        }
        else
        {
            dataList = new List<KkepItem>();
        }
    }

    private void OpenAddModal()
    {
        newItem = new KkepItem { Tanggal = DateTime.Now, Status = "Diproses", PdfUrl = "assets/docs/sample.pdf" };
        showAddModal = true;
    }

    private void CloseAddModal() => showAddModal = false;

    private void SaveData()
    {
        if (!string.IsNullOrWhiteSpace(newItem.Judul))
        {
            dataList.Insert(0, newItem);
            showAddModal = false;
        }
    }

    private void ViewPdf(string url)
    {
        selectedPdfUrl = url;
        showPdfModal = true;
    }

    private void ClosePdfModal() => showPdfModal = false;

    private void DeleteItem(KkepItem item) => dataList.Remove(item);

    public class KkepItem
    {
        public string Kode { get; set; } = "";
        public string Judul { get; set; } = "";
        public DateTime Tanggal { get; set; } = DateTime.Now;
        public string Status { get; set; } = "Diproses";
        public string PdfUrl { get; set; } = "assets/docs/sample.pdf";
    }
}