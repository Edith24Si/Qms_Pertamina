@page "/"

<div class="row">
    <!-- Stat Box: Total Data List -->
    <div class="col-sm-6 col-md-3">
        <div class="row-stat dash">
            <p class="row-stat-label">Total Data List</p>
            <h3 class="row-stat-value">@totalDataList</h3>
            <a href="documents" class="btn btn-success btn-xs">Files</a>
        </div>
    </div>

    <!-- Stat Box: Total Employee & Admin -->
    <div class="col-sm-6 col-md-3">
        <div class="row-stat dash">
            <p class="row-stat-label">Total Employee</p>
            <h3 class="row-stat-value">@totalEmployee</h3>
            <a href="employees" class="btn btn-warning btn-xs">Employee</a>
            <h3 class="row-stat-value"> &nbsp;&nbsp;&amp;&nbsp;&nbsp; </h3><br>
            <h3 class="row-stat-value">@totalAdmin</h3>
            <a href="admins" class="btn btn-info btn-xs">Admin</a>
        </div>
    </div>

    <!-- Stat Box: New Gugus -->
    <div class="col-sm-6 col-md-3">
        <div class="row-stat dash">
            <p class="row-stat-label">New Gugus</p>
            <h3 class="row-stat-value">@newGugus</h3>
            <a href="gugus/acc" class="btn btn-primary btn-xs">New Gugus</a>
        </div>
    </div>
</div> <!-- /.row -->

<hr>

<div class="row">
    <div class="col-md-12">
        <div class="portlet">
            <div class="portlet-header">
                <h3><i class="fa fa-bar-chart-o"></i> Dashboard - @username</h3>
            </div> <!-- /.portlet-header -->

            <div class="portlet-content" id="content-center">
                <br>
                <center><p>Selamat datang di Admin Page website Quality Management System</p></center>
            </div> <!-- /.portlet-content -->
        </div> <!-- /.portlet -->
    </div> <!-- /.col -->
</div>

@code {
    // Variable placeholder sementara sebelum dihubungkan ke QMS.Api / Database
    private int totalDataList = 0;
    private int totalEmployee = 0;
    private int totalAdmin = 0;
    private int newGugus = 0;
    private string username = "Administrator";

    protected override async Task OnInitializedAsync()
    {
        // Nanti di sini kita panggil Endpoint API backend:
        // totalDataList = await Http.GetFromJsonAsync<int>("api/dashboard/total-files");
        await Task.CompletedTask;
    }
}