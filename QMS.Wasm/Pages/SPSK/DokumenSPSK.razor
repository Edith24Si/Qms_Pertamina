@page "/spsk/{jenis}"
@page "/documents/{jenis}"
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<div class="container-fluid px-4 px-lg-5 py-4">

    <!-- Header & Navigasi Breadcrumb -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="dashboard" class="text-decoration-none text-danger">Beranda</a></li>
                    <li class="breadcrumb-item"><a href="documents" class="text-decoration-none text-muted">Dokumen</a></li>
                    <li class="breadcrumb-item active text-uppercase fw-semibold">@Jenis</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <i class="fa fa-file-contract text-danger"></i>
                <span>Arsip Surat &amp; Ketentuan <span class="text-uppercase text-danger">@Jenis</span></span>
            </h4>
            <p class="text-muted small mb-0">
                Pusat pengarsipan dan penelusuran berkas resmi @(Jenis?.ToLower() == "sp" ? "Surat Perintah (SP)" : "Surat Keputusan (SK)") PT Pertamina Patra Niaga RU II Dumai.
            </p>
        </div>

        <!-- Tombol Tambah Dokumen: HANYA MUNCUL UNTUK ADMINISTRATOR -->
        @if (isAdmin)
        {
            <button class="btn btn-danger rounded-pill px-4 py-2 shadow-sm fw-semibold d-inline-flex align-items-center gap-2"
                    @onclick="OpenUploadModal">
                <i class="fa fa-plus-circle"></i>
                <span>Tambah Dokumen @JenisClean</span>
            </button>
        }
    </div>

    <!-- Filter Bar: Search & Dropdown Filter Tahun Dinamis -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <!-- Search Box -->
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0 text-muted ps-3">
                            <i class="fa fa-search"></i>
                        </span>
                        <input type="text" class="form-control bg-light border-0 ps-2"
                               placeholder="Cari nomor surat, perihal, atau judul berkas..."
                               @bind="searchQuery" @bind:event="oninput" />
                        @if (!string.IsNullOrEmpty(searchQuery))
                        {
                            <button class="btn btn-light border-0" @onclick="() => searchQuery = string.Empty">
                                <i class="fa fa-times text-muted"></i>
                            </button>
                        }
                    </div>
                </div>

                <!-- Dropdown Filter Tahun Otomatis -->
                <div class="col-md-3">
                    <div class="d-flex align-items-center gap-2">
                        <label for="yearSelect" class="form-label mb-0 small fw-bold text-secondary text-nowrap">
                            <i class="fa fa-calendar-alt text-danger me-1"></i>Tahun:
                        </label>
                        <select id="yearSelect" class="form-select form-select-sm border-0 bg-light fw-semibold shadow-none rounded-3" 
                                @onchange="OnYearSelectChanged" value="@selectedYear">
                            <option value="All">Semua Tahun</option>
                            @foreach (var yr in availableYears)
                            {
                                <option value="@yr">@yr</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Counter Dokumen -->
                <div class="col-md-3 text-md-end">
                    <span class="badge bg-light text-dark border px-3 py-2 fw-semibold rounded-pill">
                        Total: <span class="text-danger fw-bold">@FilteredDocuments.Count()</span> Dokumen
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabel Daftar Dokumen -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom border-light-subtle">
                        <tr class="text-secondary small text-uppercase">
                            <th class="ps-4 py-3" style="width: 60px;">No</th>
                            <th class="py-3" style="min-width: 190px;">Nomor Dokumen</th>
                            <th class="py-3" style="min-width: 280px;">Judul &amp; Perihal Dokumen</th>
                            <th class="py-3 text-center" style="width: 100px;">Tahun</th>
                            <th class="py-3" style="width: 140px;">Tanggal Terbit</th>
                            <th class="py-3" style="width: 100px;">Ukuran</th>
                            <th class="text-center pe-4 py-3" style="min-width: 160px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredDocuments.Any())
                        {
                            int no = 1;
                            @foreach (var doc in FilteredDocuments)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-muted small">@(no++)</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="doc-icon-badge">
                                                <i class="fa fa-file-pdf text-danger"></i>
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@doc.NomorDokumen</span>
                                                <span class="badge bg-danger-subtle text-danger small py-0 px-2" style="font-size: 0.68rem;">
                                                    @doc.Kategori
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark mb-1">@doc.Judul</div>
                                        <div class="small text-muted d-flex align-items-center gap-2">
                                            <span><i class="fa fa-user-circle me-1"></i>@doc.Pengunggah</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border fw-semibold px-2 py-1">@doc.Tahun</span>
                                    </td>
                                    <td class="small text-muted">@doc.TanggalTerbit.ToString("dd MMM yyyy")</td>
                                    <td class="small text-muted">@doc.UkuranBerkas</td>
                                    
                                    <!-- Kolom Aksi Berupa Icon Saja -->
                                    <td class="text-center pe-4">
                                        <div class="d-inline-flex align-items-center gap-1">
                                            
                                            <!-- VIEW (User & Admin) -->
                                            <button class="btn btn-icon btn-soft-primary" 
                                                    title="Lihat Pratinjau Dokumen" 
                                                    @onclick="() => ViewPdf(doc.FileUrl)">
                                                <i class="fa fa-eye"></i>
                                            </button>

                                            <!-- DOWNLOAD LANGSUNG -->
                                            <a href="@doc.FileUrl" 
                                               download 
                                               target="_blank" 
                                               class="btn btn-icon btn-soft-info" 
                                               title="Unduh Berkas PDF">
                                                <i class="fa fa-download"></i>
                                            </a>

                                            <!-- EDIT & HAPUS: HANYA ADA JIKA ADMIN -->
                                            @if (isAdmin)
                                            {
                                                <button class="btn btn-icon btn-soft-warning" 
                                                        title="Edit Dokumen" 
                                                        @onclick="() => OpenEditModal(doc)">
                                                    <i class="fa fa-pencil fa-pen"></i>
                                                </button>
                                                
                                                <button class="btn btn-icon btn-soft-danger" 
                                                        title="Hapus Dokumen" 
                                                        @onclick="() => OpenDeleteConfirm(doc)">
                                                    <i class="fa fa-trash fa-trash-alt"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <div class="py-4">
                                        <i class="fa fa-folder-open fs-1 text-secondary mb-3 d-block opacity-50"></i>
                                        <h6 class="fw-bold text-dark">Tidak ada dokumen ditemukan</h6>
                                        <p class="small text-muted mb-0">
                                            Tidak ada arsip untuk kategori <strong>@JenisClean</strong> 
                                            @(selectedYear == "All" ? "" : $"pada tahun {selectedYear}") 
                                            @(string.IsNullOrEmpty(searchQuery) ? "" : $"dengan kata kunci '{searchQuery}'").
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Upload / Edit Dokumen (Admin Only) -->
@if (showFormModal && isAdmin)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.55); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0 pt-4 px-4">
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="fa @(currentDoc.Id == 0 ? "fa-plus-circle text-danger" : "fa-pen text-warning")"></i>
                        <span>@(currentDoc.Id == 0 ? "Tambah Dokumen Baru" : "Edit Informasi Dokumen") @JenisClean</span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseFormModal"></button>
                </div>
                <div class="modal-body p-4">
                    <EditForm Model="@currentDoc" OnValidSubmit="SaveDocument">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">Nomor Surat / Dokumen <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rounded-3" placeholder="Contoh: SK/RU2/2026/012" @bind="currentDoc.NomorDokumen" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">Judul / Perihal Peraturan <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rounded-3" placeholder="Masukkan judul dokumen" @bind="currentDoc.Judul" required />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary">Tahun <span class="text-danger">*</span></label>
                                <select class="form-select rounded-3" @bind="currentDoc.Tahun" required>
                                    @foreach (var yr in availableYears)
                                    {
                                        <option value="@yr">@yr</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary">Ukuran Berkas</label>
                                <input type="text" class="form-control rounded-3" placeholder="Contoh: 1.5 MB" @bind="currentDoc.UkuranBerkas" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-secondary">URL / Link File PDF <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rounded-3" placeholder="https://... atau /document/..." @bind="currentDoc.FileUrl" required />
                            <small class="text-muted" style="font-size: 0.72rem;">Masukkan tautan file PDF yang dapat diakses publik atau dokumen lokal.</small>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CloseFormModal">Batal</button>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold shadow-sm">
                                <i class="fa fa-save me-1"></i> Simpan Data
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Konfirmasi Hapus Dokumen (Admin Only) -->
@if (showDeleteModal && docToDelete != null && isAdmin)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.55); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg rounded-4 text-center p-4">
                <div class="mb-3">
                    <div class="delete-icon-wrapper mx-auto">
                        <i class="fa fa-trash-alt text-danger fs-3"></i>
                    </div>
                </div>
                <h5 class="fw-bold text-dark mb-1">Hapus Dokumen?</h5>
                <p class="text-muted small mb-4">
                    Apakah Anda yakin ingin menghapus dokumen <strong>@docToDelete.NomorDokumen</strong>? Tindakan ini tidak dapat dibatalkan.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <button class="btn btn-light rounded-pill px-3" @onclick="CloseDeleteModal">Batal</button>
                    <button class="btn btn-danger rounded-pill px-3 fw-semibold" @onclick="ConfirmDelete">
                        <i class="fa fa-trash-alt me-1"></i> Ya, Hapus
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Viewer PDF -->
@if (showPdfModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65); z-index: 1060; backdrop-filter: blur(3px);">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header bg-light border-0 py-3 px-4">
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2 mb-0">
                        <i class="fa fa-file-pdf text-danger"></i>
                        <span>Pratinjau Dokumen @JenisClean</span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="ClosePdfModal"></button>
                </div>
                <div class="modal-body p-0">
                    <iframe src="@($"{selectedPdfUrl}#toolbar=0&navpanes=0")" width="100%" height="650px" style="border: none;"></iframe>
                </div>
                <div class="modal-footer bg-light border-0 py-2 px-4 justify-content-between">
                    <span class="small text-muted">Preview interaktif dokumen Pertamina QMS</span>
                    <button type="button" class="btn btn-secondary rounded-pill px-4" @onclick="ClosePdfModal">Tutup</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    /* Styling Elegan Badge Icon */
    .doc-icon-badge {
        width: 36px;
        height: 36px;
        background-color: #fee2e2;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    /* Icon Buttons Modern */
    .btn-icon {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: none;
        transition: all 0.2s ease;
        font-size: 0.82rem;
    }

    .btn-icon:hover {
        transform: translateY(-2px);
    }

    .btn-soft-primary {
        background-color: #e0f2fe;
        color: #0284c7;
    }
    .btn-soft-primary:hover {
        background-color: #0284c7;
        color: #ffffff;
    }

    .btn-soft-info {
        background-color: #ecfdf5;
        color: #059669;
    }
    .btn-soft-info:hover {
        background-color: #059669;
        color: #ffffff;
    }

    .btn-soft-warning {
        background-color: #fef3c7;
        color: #d97706;
    }
    .btn-soft-warning:hover {
        background-color: #d97706;
        color: #ffffff;
    }

    .btn-soft-danger {
        background-color: #fee2e2;
        color: #dc2626;
    }
    .btn-soft-danger:hover {
        background-color: #dc2626;
        color: #ffffff;
    }

    .delete-icon-wrapper {
        width: 60px;
        height: 60px;
        background-color: #fee2e2;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@code {
    [Parameter] public string Jenis { get; set; } = "sp";
    private string JenisClean => (Jenis ?? "sp").ToUpper();

    private bool isAdmin = false;
    private string userRole = "User";
    private string searchQuery = string.Empty;
    private string selectedYear = "All";

    private int currentYear = DateTime.Now.Year;
    private List<int> availableYears = new List<int>();

    private bool showFormModal = false;
    private bool showDeleteModal = false;
    private bool showPdfModal = false;
    private string selectedPdfUrl = "";

    private DocumentModel currentDoc = new DocumentModel();
    private DocumentModel? docToDelete = null;
    private List<DocumentModel> documentList = new List<DocumentModel>();

    protected override void OnInitialized()
    {
        currentYear = DateTime.Now.Year;
        availableYears = Enumerable.Range(2000, currentYear - 2000 + 1).Reverse().ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            userRole = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userRole") ?? "User";
            isAdmin = userRole.Equals("Administrator", StringComparison.OrdinalIgnoreCase) ||
                      userRole.Equals("Admin", StringComparison.OrdinalIgnoreCase);
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        LoadAllData();
        await Task.CompletedTask;
    }

    private void OnYearSelectChanged(ChangeEventArgs e)
    {
        selectedYear = e.Value?.ToString() ?? "All";
    }

    private IEnumerable<DocumentModel> FilteredDocuments =>
        documentList
            .Where(d => string.Equals(d.Kategori, Jenis, StringComparison.OrdinalIgnoreCase))
            .Where(d => selectedYear == "All" || d.Tahun.ToString() == selectedYear)
            .Where(d => string.IsNullOrEmpty(searchQuery) ||
                        d.NomorDokumen.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                        d.Judul.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(d => d.Tahun)
            .ThenByDescending(d => d.TanggalTerbit);

    private void LoadAllData()
    {
        searchQuery = string.Empty;

        documentList = new List<DocumentModel>
        {
            new DocumentModel { Id = 1, NomorDokumen = $"{Jenis.ToUpper()}/RU2/2026/001", Judul = $"Pedoman Keselamatan Kerja Kilang RU II ({Jenis.ToUpper()} 2026)", Kategori = Jenis.ToUpper(), Tahun = 2026, TanggalTerbit = DateTime.Now.AddDays(-10), UkuranBerkas = "2.4 MB", Pengunggah = "Admin QMS", FileUrl = "document/Template_Risalah_2026.pdf" },
            new DocumentModel { Id = 2, NomorDokumen = $"{Jenis.ToUpper()}/RU2/2025/008", Judul = $"Standar Operasional Prosedur Pengujian Mutu ({Jenis.ToUpper()} 2025)", Kategori = Jenis.ToUpper(), Tahun = 2025, TanggalTerbit = DateTime.Now.AddDays(-120), UkuranBerkas = "1.8 MB", Pengunggah = "Admin QMS", FileUrl = "document/Template_Risalah_2026.pdf" },
            new DocumentModel { Id = 3, NomorDokumen = $"{Jenis.ToUpper()}/RU2/2024/015", Judul = $"Instruksi Kerja Pengolahan Minyak Mentah ({Jenis.ToUpper()} 2024)", Kategori = Jenis.ToUpper(), Tahun = 2024, TanggalTerbit = DateTime.Now.AddDays(-400), UkuranBerkas = "3.1 MB", Pengunggah = "Admin QMS", FileUrl = "document/Template_Risalah_2026.pdf" },
            new DocumentModel { Id = 4, NomorDokumen = $"{Jenis.ToUpper()}/RU2/2023/003", Judul = $"Peraturan Manajemen Risiko Operasional ({Jenis.ToUpper()} 2023)", Kategori = Jenis.ToUpper(), Tahun = 2023, TanggalTerbit = DateTime.Now.AddDays(-800), UkuranBerkas = "1.2 MB", Pengunggah = "Admin QMS", FileUrl = "document/Template_Risalah_2026.pdf" },
            new DocumentModel { Id = 5, NomorDokumen = $"{Jenis.ToUpper()}/RU2/2022/011", Judul = $"Kebijakan Efisiensi Energi Kilang Dumai ({Jenis.ToUpper()} 2022)", Kategori = Jenis.ToUpper(), Tahun = 2022, TanggalTerbit = DateTime.Now.AddDays(-1100), UkuranBerkas = "2.0 MB", Pengunggah = "Admin QMS", FileUrl = "document/Template_Risalah_2026.pdf" },
            new DocumentModel { Id = 6, NomorDokumen = $"{Jenis.ToUpper()}/RU2/2021/005", Judul = $"Prosedur Penanganan Limbah B3 Kilang ({Jenis.ToUpper()} 2021)", Kategori = Jenis.ToUpper(), Tahun = 2021, TanggalTerbit = DateTime.Now.AddDays(-1400), UkuranBerkas = "1.5 MB", Pengunggah = "Admin QMS", FileUrl = "document/Template_Risalah_2026.pdf" },
            new DocumentModel { Id = 7, NomorDokumen = $"{Jenis.ToUpper()}/RU2/2020/002", Judul = $"Pelaksanaan Protocol Health K3LL ({Jenis.ToUpper()} 2020)", Kategori = Jenis.ToUpper(), Tahun = 2020, TanggalTerbit = DateTime.Now.AddDays(-1800), UkuranBerkas = "1.1 MB", Pengunggah = "Admin QMS", FileUrl = "document/Template_Risalah_2026.pdf" },
            new DocumentModel { Id = 8, NomorDokumen = $"{Jenis.ToUpper()}/RU2/2010/001", Judul = $"Ketentuan Dasar Audit Mutu Internal ({Jenis.ToUpper()} 2010)", Kategori = Jenis.ToUpper(), Tahun = 2010, TanggalTerbit = DateTime.Now.AddDays(-5000), UkuranBerkas = "2.8 MB", Pengunggah = "Admin QMS", FileUrl = "document/Template_Risalah_2026.pdf" },
            new DocumentModel { Id = 9, NomorDokumen = $"{Jenis.ToUpper()}/RU2/2005/001", Judul = $"Master Plan Pembentukan Kilang Dumai ({Jenis.ToUpper()} 2005)", Kategori = Jenis.ToUpper(), Tahun = 2005, TanggalTerbit = DateTime.Now.AddDays(-7000), UkuranBerkas = "4.2 MB", Pengunggah = "Admin QMS", FileUrl = "document/Template_Risalah_2026.pdf" }
        };
    }

    private void OpenUploadModal()
    {
        currentDoc = new DocumentModel
        {
            Id = 0,
            Kategori = Jenis.ToUpper(),
            Tahun = currentYear,
            FileUrl = "document/Template_Risalah_2026.pdf",
            UkuranBerkas = "1.5 MB"
        };
        showFormModal = true;
    }

    private void OpenEditModal(DocumentModel doc)
    {
        currentDoc = new DocumentModel
        {
            Id = doc.Id,
            NomorDokumen = doc.NomorDokumen,
            Judul = doc.Judul,
            Kategori = doc.Kategori,
            Tahun = doc.Tahun,
            TanggalTerbit = doc.TanggalTerbit,
            UkuranBerkas = doc.UkuranBerkas,
            Pengunggah = doc.Pengunggah,
            FileUrl = doc.FileUrl
        };
        showFormModal = true;
    }

    private void CloseFormModal() => showFormModal = false;

    private void SaveDocument()
    {
        if (currentDoc.Id == 0)
        {
            currentDoc.Id = documentList.Any() ? documentList.Max(d => d.Id) + 1 : 1;
            currentDoc.TanggalTerbit = DateTime.Now;
            currentDoc.Pengunggah = userRole;
            documentList.Insert(0, currentDoc);
        }
        else
        {
            var index = documentList.FindIndex(d => d.Id == currentDoc.Id);
            if (index != -1)
            {
                documentList[index] = currentDoc;
            }
        }
        showFormModal = false;
    }

    private void OpenDeleteConfirm(DocumentModel doc)
    {
        docToDelete = doc;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        docToDelete = null;
    }

    private void ConfirmDelete()
    {
        if (docToDelete != null)
        {
            documentList.RemoveAll(d => d.Id == docToDelete.Id);
        }
        CloseDeleteModal();
    }

    private void ViewPdf(string url)
    {
        selectedPdfUrl = url;
        showPdfModal = true;
    }

    private void ClosePdfModal() => showPdfModal = false;

    public class DocumentModel
    {
        public int Id { get; set; }
        public string NomorDokumen { get; set; } = string.Empty;
        public string Judul { get; set; } = string.Empty;
        public string Kategori { get; set; } = string.Empty;
        public int Tahun { get; set; } = DateTime.Now.Year;
        public DateTime TanggalTerbit { get; set; } = DateTime.Now;
        public string UkuranBerkas { get; set; } = "1.5 MB";
        public string Pengunggah { get; set; } = "Admin QMS";
        public string FileUrl { get; set; } = "document/Template_Risalah_2026.pdf";
    }
}
