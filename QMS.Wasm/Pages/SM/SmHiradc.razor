@page "/sm/hiradc"
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<div class="container-fluid px-4 px-lg-5 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="fa fa-shield-alt text-danger me-2"></i>HIRADC
            </h4>
            <p class="text-muted small mb-0">Hazard Identification, Risk Assessment, and Determining Control — Keselamatan Kilang RU II Dumai</p>
        </div>
        @if (isAdmin)
        {
            <button class="btn btn-danger btn-sm rounded-pill px-4 fw-semibold shadow-sm" @onclick="OpenAddModal">
                <i class="fa fa-plus me-1"></i> Tambah Identifikasi Bahaya
            </button>
        }
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-light p-2">
        <div class="input-group">
            <span class="input-group-text bg-transparent border-0 text-muted"><i class="fa fa-search"></i></span>
            <input type="text" class="form-control bg-transparent border-0" placeholder="Cari kegiatan atau bahaya pekerjaan..." @bind="searchQuery" @bind:event="oninput" />
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="small text-uppercase text-secondary">
                            <th class="ps-4 py-3" style="width: 50px;">No</th>
                            <th class="py-3">Aktivitas Pekerjaan</th>
                            <th class="py-3">Potensi Bahaya</th>
                            <th class="py-3 text-center">Tingkat Risiko</th>
                            <th class="py-3">Pengendalian Risiko</th>
                            <th class="text-center pe-4 py-3" style="min-width: 120px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredList.Any())
                        {
                            int no = 1;
                            @foreach (var item in FilteredList)
                            {
                                <tr>
                                    <td class="ps-4 small text-muted">@(no++)</td>
                                    <td class="fw-semibold text-dark">@item.Aktivitas</td>
                                    <td>@item.Bahaya</td>
                                    <td class="text-center">
                                        <span class="badge @(item.TingkatRisiko == "Tinggi" ? "bg-danger-subtle text-danger" : item.TingkatRisiko == "Sedang" ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success")">
                                            @item.TingkatRisiko
                                        </span>
                                    </td>
                                    <td class="small">@item.Pengendalian</td>
                                    <!-- Aksi: User (View), Admin (Semua) -->
                                    <td class="text-center pe-4">
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <button class="btn btn-icon btn-soft-primary" title="Lihat Detail HIRADC" @onclick="() => ViewItem(item)">
                                                <i class="fa fa-eye"></i>
                                            </button>

                                            @if (isAdmin)
                                            {
                                                <button class="btn btn-icon btn-soft-warning" title="Edit Data" @onclick="() => EditItem(item)">
                                                    <i class="fa fa-pencil fa-pen"></i>
                                                </button>
                                                <button class="btn btn-icon btn-soft-danger" title="Hapus Data" @onclick="() => DeleteItem(item.Id)">
                                                    <i class="fa fa-trash fa-trash-alt"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted">Data identifikasi bahaya tidak ditemukan.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (isModalOpen && isAdmin)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0 pt-4 px-4 pb-0">
                    <h5 class="modal-title fw-bold">@(currentItem.Id == 0 ? "Tambah" : "Edit") HIRADC</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Aktivitas Pekerjaan *</label>
                        <input type="text" class="form-control" @bind="currentItem.Aktivitas" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Potensi Bahaya *</label>
                        <input type="text" class="form-control" @bind="currentItem.Bahaya" />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold">Tingkat Risiko</label>
                            <select class="form-select" @bind="currentItem.TingkatRisiko">
                                <option value="Rendah">Rendah</option>
                                <option value="Sedang">Sedang</option>
                                <option value="Tinggi">Tinggi</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold">Pengendalian</label>
                            <input type="text" class="form-control" @bind="currentItem.Pengendalian" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <button class="btn btn-light rounded-pill px-4" @onclick="CloseModal">Batal</button>
                        <button class="btn btn-danger rounded-pill px-4 fw-semibold" @onclick="SaveItem">Simpan Data</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- View Modal -->
@if (showViewModal && viewingItem != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow text-center p-4">
                <div class="bg-danger-subtle text-danger rounded-circle p-3 d-inline-flex mx-auto mb-3">
                    <i class="fa fa-shield-alt fs-2"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">@viewingItem.Aktivitas</h5>
                <span class="badge @(viewingItem.TingkatRisiko == "Tinggi" ? "bg-danger" : viewingItem.TingkatRisiko == "Sedang" ? "bg-warning text-dark" : "bg-success") rounded-pill px-3 py-1 mb-3">
                    Risiko @viewingItem.TingkatRisiko
                </span>

                <div class="text-start bg-light rounded-3 p-3 small mb-3">
                    <div class="mb-2"><strong>Potensi Bahaya:</strong> @viewingItem.Bahaya</div>
                    <div class="mb-2"><strong>Tindakan Pengendalian:</strong> @viewingItem.Pengendalian</div>
                    <div><strong>Unit Pengawas:</strong> HSSE Pertamina RU II Dumai</div>
                </div>

                <div>
                    <button class="btn btn-secondary rounded-pill px-4" @onclick="() => showViewModal = false">Tutup</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .btn-icon {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: none;
        transition: all 0.2s ease;
        font-size: 0.82rem;
    }
    .btn-icon:hover { transform: translateY(-2px); }
    .btn-soft-primary { background-color: #e0f2fe; color: #0284c7; }
    .btn-soft-primary:hover { background-color: #0284c7; color: #ffffff; }
    .btn-soft-warning { background-color: #fef3c7; color: #d97706; }
    .btn-soft-warning:hover { background-color: #d97706; color: #ffffff; }
    .btn-soft-danger { background-color: #fee2e2; color: #dc2626; }
    .btn-soft-danger:hover { background-color: #dc2626; color: #ffffff; }
</style>

@code {
    public class HiradcModel
    {
        public int Id { get; set; }
        public string Aktivitas { get; set; } = "";
        public string Bahaya { get; set; } = "";
        public string TingkatRisiko { get; set; } = "Sedang";
        public string Pengendalian { get; set; } = "";
    }

    private List<HiradcModel> items = new()
    {
        new HiradcModel { Id = 1, Aktivitas = "Pekerjaan di Ruang Terbatas (Confined Space)", Bahaya = "Gas Beracun / Kekurangan Oksigen", TingkatRisiko = "Tinggi", Pengendalian = "Sika, Gas Test, SCBA" },
        new HiradcModel { Id = 2, Aktivitas = "Perbaikan Pipa Ketinggian > 2 Meter", Bahaya = "Jatuh dari Ketinggian", TingkatRisiko = "Tinggi", Pengendalian = "Full Body Harness, Scaffolding" },
        new HiradcModel { Id = 3, Aktivitas = "Pengoperasian Forklift di Area Warehouse", Bahaya = "Tertabrak / Material Roboh", TingkatRisiko = "Sedang", Pengendalian = "Sertifikat SIO, Barikade Area" }
    };

    private string searchQuery = "";
    private bool isModalOpen = false;
    private bool showViewModal = false;
    private bool isAdmin = false;

    private HiradcModel currentItem = new();
    private HiradcModel? viewingItem;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userRole = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userRole");
            isAdmin = userRole?.Equals("Administrator", StringComparison.OrdinalIgnoreCase) == true ||
                      userRole?.Equals("Admin", StringComparison.OrdinalIgnoreCase) == true;
            StateHasChanged();
        }
    }

    private IEnumerable<HiradcModel> FilteredList =>
        string.IsNullOrWhiteSpace(searchQuery)
        ? items
        : items.Where(x => x.Aktivitas.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                           x.Bahaya.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private void ViewItem(HiradcModel item)
    {
        viewingItem = item;
        showViewModal = true;
    }

    private void OpenAddModal() { currentItem = new HiradcModel(); isModalOpen = true; }
    private void EditItem(HiradcModel item) { currentItem = new HiradcModel { Id = item.Id, Aktivitas = item.Aktivitas, Bahaya = item.Bahaya, TingkatRisiko = item.TingkatRisiko, Pengendalian = item.Pengendalian }; isModalOpen = true; }
    private void CloseModal() => isModalOpen = false;

    private void SaveItem()
    {
        if (currentItem.Id == 0)
        {
            currentItem.Id = items.Any() ? items.Max(x => x.Id) + 1 : 1;
            items.Add(currentItem);
        }
        else
        {
            var index = items.FindIndex(x => x.Id == currentItem.Id);
            if (index != -1) items[index] = currentItem;
        }
        isModalOpen = false;
    }

    private void DeleteItem(int id) => items.RemoveAll(x => x.Id == id);
}
