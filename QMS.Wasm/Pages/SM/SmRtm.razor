@page "/sm/rtm"
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<div class="container-fluid px-4 px-lg-5 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="fa fa-users-cog text-danger me-2"></i>Rapat Tinjauan Manajemen (RTM)
            </h4>
            <p class="text-muted small mb-0">Jadwal, risalah evaluasi, dan tindak lanjut Tinjauan Manajemen RU II Dumai</p>
        </div>
        @if (isAdmin)
        {
            <button class="btn btn-danger btn-sm rounded-pill px-4 fw-semibold shadow-sm" @onclick="OpenAddModal">
                <i class="fa fa-plus me-1"></i> Jadwalkan RTM
            </button>
        }
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-light p-2">
        <div class="input-group">
            <span class="input-group-text bg-transparent border-0 text-muted"><i class="fa fa-search"></i></span>
            <input type="text" class="form-control bg-transparent border-0" placeholder="Cari judul RTM atau periode..." @bind="searchQuery" @bind:event="oninput" />
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="small text-uppercase text-secondary">
                            <th class="ps-4 py-3" style="width: 50px;">No</th>
                            <th class="py-3">Judul Rapat RTM</th>
                            <th class="py-3">Periode</th>
                            <th class="py-3">Tanggal Pelaksanaan</th>
                            <th class="py-3 text-center">Status Risalah</th>
                            <th class="text-center pe-4 py-3" style="min-width: 140px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredList.Any())
                        {
                            int no = 1;
                            @foreach (var item in FilteredList)
                            {
                                <tr>
                                    <td class="ps-4 small text-muted">@(no++)</td>
                                    <td class="fw-semibold text-dark">@item.Judul</td>
                                    <td><span class="badge bg-danger-subtle text-danger">@item.Periode</span></td>
                                    <td class="small text-muted">@item.Tanggal.ToString("dd MMM yyyy")</td>
                                    <td class="text-center"><span class="badge bg-success-subtle text-success">@item.Hasil</span></td>
                                    <!-- Aksi: User (View & Unduh), Admin (Semua) -->
                                    <td class="text-center pe-4">
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <button class="btn btn-icon btn-soft-primary" title="Lihat Notulen RTM" @onclick="() => ViewItem(item)">
                                                <i class="fa fa-eye"></i>
                                            </button>
                                            <a href="document/Template_Risalah_2026.pdf" download target="_blank" class="btn btn-icon btn-soft-info" title="Unduh Risalah">
                                                <i class="fa fa-download"></i>
                                            </a>

                                            @if (isAdmin)
                                            {
                                                <button class="btn btn-icon btn-soft-warning" title="Edit Jadwal" @onclick="() => EditItem(item)">
                                                    <i class="fa fa-pencil fa-pen"></i>
                                                </button>
                                                <button class="btn btn-icon btn-soft-danger" title="Hapus Jadwal" @onclick="() => DeleteItem(item.Id)">
                                                    <i class="fa fa-trash fa-trash-alt"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted">Data RTM tidak ditemukan.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (isModalOpen && isAdmin)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0 pt-4 px-4 pb-0">
                    <h5 class="modal-title fw-bold">@(currentItem.Id == 0 ? "Tambah" : "Edit") Agenda RTM</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Judul RTM *</label>
                        <input type="text" class="form-control" @bind="currentItem.Judul" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Periode / Triwulan *</label>
                        <input type="text" class="form-control" @bind="currentItem.Periode" placeholder="Contoh: Semester I - 2026" />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold">Tanggal Pelaksanaan</label>
                            <input type="date" class="form-control" @bind="currentItem.Tanggal" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold">Status Notulen</label>
                            <input type="text" class="form-control" @bind="currentItem.Hasil" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <button class="btn btn-light rounded-pill px-4" @onclick="CloseModal">Batal</button>
                        <button class="btn btn-danger rounded-pill px-4 fw-semibold" @onclick="SaveItem">Simpan Data</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- View Modal -->
@if (showViewModal && viewingItem != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow text-center p-4">
                <div class="bg-danger-subtle text-danger rounded-circle p-3 d-inline-flex mx-auto mb-3">
                    <i class="fa fa-users-cog fs-2"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">@viewingItem.Judul</h5>
                <span class="badge bg-danger rounded-pill px-3 py-1 mb-3">@viewingItem.Periode</span>

                <div class="text-start bg-light rounded-3 p-3 small mb-3">
                    <div class="mb-2"><strong>Tanggal Pelaksanaan:</strong> @viewingItem.Tanggal.ToString("dd MMMM yyyy")</div>
                    <div class="mb-2"><strong>Status Risalah:</strong> <span class="badge bg-success">@viewingItem.Hasil</span></div>
                    <div><strong>Pemimpin Rapat:</strong> General Manager &amp; Tim Manajemen Mutu RU II Dumai</div>
                </div>

                <div>
                    <button class="btn btn-secondary rounded-pill px-4" @onclick="() => showViewModal = false">Tutup</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .btn-icon {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: none;
        transition: all 0.2s ease;
        font-size: 0.82rem;
    }
    .btn-icon:hover { transform: translateY(-2px); }
    .btn-soft-primary { background-color: #e0f2fe; color: #0284c7; }
    .btn-soft-primary:hover { background-color: #0284c7; color: #ffffff; }
    .btn-soft-info { background-color: #ecfdf5; color: #059669; }
    .btn-soft-info:hover { background-color: #059669; color: #ffffff; }
    .btn-soft-warning { background-color: #fef3c7; color: #d97706; }
    .btn-soft-warning:hover { background-color: #d97706; color: #ffffff; }
    .btn-soft-danger { background-color: #fee2e2; color: #dc2626; }
    .btn-soft-danger:hover { background-color: #dc2626; color: #ffffff; }
</style>

@code {
    public class RtmModel
    {
        public int Id { get; set; }
        public string Judul { get; set; } = "";
        public string Periode { get; set; } = "";
        public DateTime Tanggal { get; set; } = DateTime.Now;
        public string Hasil { get; set; } = "Selesai";
    }

    private List<RtmModel> items = new()
    {
        new RtmModel { Id = 1, Judul = "RTM Tinjauan Kinerja Sistem Mutu Semester I - 2026", Periode = "Semester I 2026", Tanggal = new DateTime(2026, 6, 25), Hasil = "Telah Disetujui GM" },
        new RtmModel { Id = 2, Judul = "RTM Evaluasi Sasaran Mutu Kilang Triwulan IV - 2025", Periode = "Triwulan IV 2025", Tanggal = new DateTime(2025, 12, 18), Hasil = "Telah Disetujui GM" }
    };

    private string searchQuery = "";
    private bool isModalOpen = false;
    private bool showViewModal = false;
    private bool isAdmin = false;

    private RtmModel currentItem = new();
    private RtmModel? viewingItem;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userRole = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userRole");
            isAdmin = userRole?.Equals("Administrator", StringComparison.OrdinalIgnoreCase) == true ||
                      userRole?.Equals("Admin", StringComparison.OrdinalIgnoreCase) == true;
            StateHasChanged();
        }
    }

    private IEnumerable<RtmModel> FilteredList =>
        string.IsNullOrWhiteSpace(searchQuery)
        ? items
        : items.Where(x => x.Judul.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                           x.Periode.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private void ViewItem(RtmModel item)
    {
        viewingItem = item;
        showViewModal = true;
    }

    private void OpenAddModal() { currentItem = new RtmModel { Tanggal = DateTime.Now }; isModalOpen = true; }
    private void EditItem(RtmModel item) { currentItem = new RtmModel { Id = item.Id, Judul = item.Judul, Periode = item.Periode, Tanggal = item.Tanggal, Hasil = item.Hasil }; isModalOpen = true; }
    private void CloseModal() => isModalOpen = false;

    private void SaveItem()
    {
        if (currentItem.Id == 0)
        {
            currentItem.Id = items.Any() ? items.Max(x => x.Id) + 1 : 1;
            items.Add(currentItem);
        }
        else
        {
            var index = items.FindIndex(x => x.Id == currentItem.Id);
            if (index != -1) items[index] = currentItem;
        }
        isModalOpen = false;
    }

    private void DeleteItem(int id) => items.RemoveAll(x => x.Id == id);
}
