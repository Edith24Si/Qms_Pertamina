@page "/employee/add"
@inject HttpClient Http

<div class="row">
    <div class="col-md-8">
        <div class="portlet">
            <div class="portlet-header">
                <h3><i class="fa fa-users"></i> Add Employee</h3>
            </div>
            <div class="portlet-content" id="content-center">
                
                @if (alertType == "success")
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <strong>Well done!</strong> You successfully adding data.
                    </div>
                }
                else if (alertType == "fail")
                {
                    <div class="alert alert-warning alert-dismissible fade show">
                        <strong>Maaf</strong> Terjadi Kesalahan Dalam Membuat User.
                    </div>
                }
                else if (alertType == "error")
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <strong>Sorry!</strong> Employee Number was used!
                    </div>
                }

                <EditForm Model="@employeeModel" OnValidSubmit="HandleAddEmployee" class="form-horizontal">
                    <DataAnnotationsValidator />

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">Nomor Pegawai</label>
                        <div class="col-md-5">
                            <InputText @bind-Value="employeeModel.Nopeg" class="form-control" placeholder="Employee Number" required />
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">Nama Pegawai</label>
                        <div class="col-md-8">
                            <InputText @bind-Value="employeeModel.EmpName" class="form-control" placeholder="Employee Name" required />
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">Password</label>
                        <div class="col-md-8">
                            <InputText @bind-Value="employeeModel.Password" type="password" class="form-control" placeholder="Type Password" required />
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-md-3 col-form-label">Email</label>
                        <div class="col-md-6">
                            <InputText @bind-Value="employeeModel.Mail" type="email" class="form-control" placeholder="Email Address" required />
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">
                            <button type="submit" class="btn btn-primary">
                                Add &nbsp;&nbsp; <i class="fa fa-plus-square"></i>
                            </button>
                        </div>
                    </div>
                </EditForm>

            </div>
        </div>
    </div>
</div>

@code {
    private EmployeeFormModel employeeModel = new();
    private string? alertType;

    private async Task HandleAddEmployee()
    {
        // Call API backend nanti: POST api/employee
        // Jika sukses:
        alertType = "success";
        employeeModel = new(); // Reset form
        await Task.CompletedTask;
    }

    public class EmployeeFormModel
    {
        public string Nopeg { get; set; } = string.Empty;
        public string EmpName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Mail { get; set; } = string.Empty;
    }
}