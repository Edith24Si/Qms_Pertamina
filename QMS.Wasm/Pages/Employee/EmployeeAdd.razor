@page "/employee/add"
@inject QmsApiService ApiService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="container-fluid px-4 px-lg-5 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                        <i class="fa fa-user-plus text-danger"></i>
                        <span>Tambah Data Pekerja Baru</span>
                    </h4>
                    <p class="text-muted small mb-0">Master Data Pekerja PT Pertamina Patra Niaga RU II Dumai</p>
                </div>
                <NavLink href="pegawai" class="btn btn-outline-secondary rounded-pill px-4 small">
                    <i class="fa fa-arrow-left me-1"></i> Kembali
                </NavLink>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4">
                @if (!string.IsNullOrEmpty(alertMessage))
                {
                    <div class="alert alert-danger rounded-3 alert-dismissible fade show" role="alert">
                        <strong>Perhatian:</strong> @alertMessage
                        <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
                    </div>
                }

                <EditForm Model="@formModel" OnValidSubmit="HandleSave">
                    <DataAnnotationsValidator />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Nomor Pekerja (NIP) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control rounded-3" placeholder="Contoh: 748123" @bind="formModel.NoPeg" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Nama Lengkap Pekerja <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rounded-3" placeholder="Contoh: Budi Santoso, S.T." @bind="formModel.EmpName" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Email Resmi</label>
                            <input type="email" class="form-control rounded-3" placeholder="nama@pertamina.com" @bind="formModel.Email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">No. Handphone / WhatsApp</label>
                            <input type="text" class="form-control rounded-3" placeholder="08xxxxxxxxxx" @bind="formModel.Telpon" />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Jabatan</label>
                            <input type="text" class="form-control rounded-3" placeholder="Contoh: Section Head QA" @bind="formModel.Jabatan" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Fungsi / Department</label>
                            <input type="text" class="form-control rounded-3" placeholder="Contoh: QA RU II" @bind="formModel.Fungsi" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <NavLink href="pegawai" class="btn btn-light rounded-pill px-4">Batal</NavLink>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold shadow-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Menyimpan...</span>
                            }
                            else
                            {
                                <i class="fa fa-save me-1"></i>
                                <span>Simpan Data</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private TbEmployee formModel = new();
    private bool isSaving = false;
    private string? alertMessage;

    private async Task HandleSave()
    {
        if (formModel.NoPeg <= 0 || string.IsNullOrWhiteSpace(formModel.EmpName))
        {
            alertMessage = "Nomor Pekerja dan Nama Lengkap wajib diisi!";
            return;
        }

        isSaving = true;
        try
        {
            var success = await ApiService.CreateEmployeeAsync(formModel);
            if (success)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Pekerja baru berhasil ditambahkan!");
                Navigation.NavigateTo("pegawai");
            }
            else
            {
                alertMessage = "Gagal menyimpan data ke API backend.";
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
