@page "/documents"
@using QMS.Core.Models
@using QMS.Wasm.Services
@inject QmsApiService QmsService

<PageTitle>Daftar Dokumen Mutu</PageTitle>

<h3>Quality Management Documents</h3>

@if (documents == null)
{
    <p><em>Memuat data dari backend C# API...</em></p>
}
else
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>No. Dokumen</th>
                <th>Judul</th>
                <th>Kategori</th>
                <th>Versi</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doc in documents)
            {
                <tr>
                    <td>@doc.DocumentNumber</td>
                    <td>@doc.Title</td>
                    <td>@doc.Category</td>
                    <td>@doc.Version</td>
                    <td>
                        @if (doc.IsApproved)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<QualityDocument>? documents;

    protected override async Task OnInitializedAsync()
    {
        documents = await QmsService.GetDocumentsAsync();
    }
}