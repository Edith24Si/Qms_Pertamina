@code {
    private bool isAdmin = false;
    private bool isLoading = true;
    private bool isSubmitting = false;

    private List<TbEmployee> allEmployees = new();
    private List<string> distinctFungsi = new();

    private string searchQuery = string.Empty;
    private string selectedFungsi = string.Empty;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 15;

    // Modals
    private bool showAddModal = false;
    private bool showEditModal = false;
    private bool showViewModal = false;
    private bool showDeleteModal = false;

    private TbEmployee newEmp = new();
    private TbEmployee? editingEmp;
    private TbEmployee? viewingEmp;
    private TbEmployee? deletingEmp;

    // Alert
    private string alertMessage = string.Empty;
    private string alertType = "success";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var role = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userRole");
                isAdmin = (role == "Administrator");
                StateHasChanged();
            }
            catch {}
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            allEmployees = await ApiService.GetEmployeesAsync(limit: 500);
            distinctFungsi = allEmployees
                .Select(e => e.Fungsi ?? string.Empty)
                .Where(f => !string.IsNullOrWhiteSpace(f))
                .Distinct()
                .OrderBy(f => f)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading employees: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<TbEmployee> FilteredEmployees
    {
        get
        {
            var q = allEmployees.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(selectedFungsi))
            {
                q = q.Where(e => (e.Fungsi ?? string.Empty).Equals(selectedFungsi, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var s = searchQuery.Trim().ToLower();
                q = q.Where(e => e.EmpName.ToLower().Contains(s) ||
                                 e.NoPeg.ToString().Contains(s) ||
                                 (e.Email ?? string.Empty).ToLower().Contains(s) ||
                                 (e.Jabatan ?? string.Empty).ToLower().Contains(s) ||
                                 (e.Fungsi ?? string.Empty).ToLower().Contains(s));
            }

            return q.ToList();
        }
    }

    private List<TbEmployee> PagedEmployees =>
        FilteredEmployees.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    private int TotalPages => (int)Math.Ceiling((double)FilteredEmployees.Count / pageSize);

    private void OnFungsiChanged(ChangeEventArgs e)
    {
        selectedFungsi = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
    }

    // Modal Actions
    private void OpenAddModal()
    {
        newEmp = new TbEmployee
        {
            NoPeg = 0,
            Fungsi = "Quality Management",
            Jabatan = "Staff Mutu"
        };
        showAddModal = true;
    }

    private async Task HandleSaveNewEmp()
    {
        isSubmitting = true;
        var success = await ApiService.CreateEmployeeAsync(newEmp);
        isSubmitting = false;

        if (success)
        {
            showAddModal = false;
            alertType = "success";
            alertMessage = $"Data pekerja '{newEmp.EmpName}' berhasil ditambahkan ke database!";
            await LoadDataAsync();
        }
        else
        {
            alertType = "danger";
            alertMessage = "Gagal menyimpan data pekerja baru.";
        }
    }

    private void OpenEditModal(TbEmployee emp)
    {
        editingEmp = new TbEmployee
        {
            NoPeg = emp.NoPeg,
            EmpName = emp.EmpName,
            Email = emp.Email,
            Fungsi = emp.Fungsi,
            Jabatan = emp.Jabatan,
            Telpon = emp.Telpon,
            Password = emp.Password,
            ResetPswd = emp.ResetPswd
        };
        showEditModal = true;
    }

    private async Task HandleSaveEditEmp()
    {
        if (editingEmp == null) return;
        isSubmitting = true;
        var success = await ApiService.UpdateEmployeeAsync(editingEmp.NoPeg, editingEmp);
        isSubmitting = false;

        if (success)
        {
            showEditModal = false;
            alertType = "success";
            alertMessage = $"Data pekerja #{editingEmp.NoPeg} berhasil diperbarui!";
            await LoadDataAsync();
        }
        else
        {
            alertType = "danger";
            alertMessage = "Gagal memperbarui data pekerja.";
        }
    }

    private void OpenViewModal(TbEmployee emp)
    {
        viewingEmp = emp;
        showViewModal = true;
    }

    private void OpenDeleteConfirm(TbEmployee emp)
    {
        deletingEmp = emp;
        showDeleteModal = true;
    }

    private async Task ConfirmDeleteEmp()
    {
        if (deletingEmp == null) return;
        isSubmitting = true;
        var success = await ApiService.DeleteEmployeeAsync(deletingEmp.NoPeg);
        isSubmitting = false;

        if (success)
        {
            showDeleteModal = false;
            alertType = "success";
            alertMessage = $"Data pekerja #{deletingEmp.NoPeg} '{deletingEmp.EmpName}' berhasil dihapus!";
            await LoadDataAsync();
        }
        else
        {
            alertType = "danger";
            alertMessage = "Gagal menghapus data pekerja.";
        }
    }
}
