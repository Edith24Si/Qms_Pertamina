<style>
    /* Desain Elegan, Kompak, Tanpa Icon, Tidak Terlalu Lebar */
    .qms-nav-list {
        gap: 2px;
    }

    .qms-nav-link {
        color: rgba(255, 255, 255, 0.90) !important;
        font-size: 0.835rem;
        font-weight: 500;
        letter-spacing: 0.25px;
        padding: 8px 12px !important;
        border-radius: 6px;
        transition: all 0.18s ease;
        white-space: nowrap;
        cursor: pointer;
        user-select: none;
    }

    .qms-nav-link:hover {
        color: #ffffff !important;
        background-color: rgba(255, 255, 255, 0.14);
    }

    .qms-nav-link.active {
        color: #ffffff !important;
        background-color: rgba(0, 0, 0, 0.22);
        font-weight: 600;
        box-shadow: inset 0 -2px 0 #ffffff;
    }

    /* Support Hover di Layar Desktop (Mudah Diakses Langsung) */
    @@media (min-width: 992px) {
        .nav-item.dropdown:hover > .dropdown-menu {
            display: block !important;
            opacity: 1 !important;
            visibility: visible !important;
        }
    }

    .dropdown-menu {
        background-color: #ffffff;
        min-width: 205px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 8px;
        z-index: 1060;
    }

    .dropdown-item {
        font-size: 0.82rem;
        color: #334155;
        padding: 8px 16px;
        font-weight: 500;
        transition: all 0.14s ease;
    }

    .dropdown-item:hover {
        background-color: #fee2e2;
        color: #dc2626;
        padding-left: 20px;
    }

    .dropdown-divider {
        border-top: 1px solid #f1f5f9;
    }
</style>

@code {
    private string? openDropdown = null;
    private bool isAdmin = false;

    protected override void OnInitialized()
    {
        UserState.OnChange += HandleUserStateChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    public void Dispose()
    {
        UserState.OnChange -= HandleUserStateChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private void HandleUserStateChanged()
    {
        isAdmin = UserState.IsAdmin;
        StateHasChanged();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        openDropdown = null;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var role = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userRole");
            isAdmin = !string.IsNullOrEmpty(role) && 
                      (role.Equals("Administrator", StringComparison.OrdinalIgnoreCase) || 
                       role.Equals("Admin", StringComparison.OrdinalIgnoreCase));
            StateHasChanged();
        }
    }

    private void ToggleDropdown(string name)
    {
        if (openDropdown == name)
        {
            openDropdown = null;
        }
        else
        {
            openDropdown = name;
        }
    }

    private void CloseDropdowns()
    {
        openDropdown = null;
    }
}
