{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Qms_Pertamina.sln",
        "-m:1"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-api",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/QMS.Api/QMS.Api.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-backend",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Backend/Backend.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-wasm",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/QMS.Wasm/QMS.Wasm.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run-api",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/QMS.Api/QMS.Api.csproj",
        "--launch-profile",
        "https"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": "^$" }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*(Building|Determining projects to restore)...",
          "endsPattern": "^.*(Application started|Now listening on:).*"
        }
      }
    },
    {
      "label": "run-wasm",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/QMS.Wasm/QMS.Wasm.csproj",
        "--launch-profile",
        "http"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": "^$" }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*(Building|Determining projects to restore)...",
          "endsPattern": "^.*(Application started|Now listening on:).*"
        }
      }
    },
    {
      "label": "Run Both (API + WASM)",
      "dependsOn": [
        "run-api",
        "run-wasm"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "watch-api",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "--project",
        "${workspaceFolder}/QMS.Api/QMS.Api.csproj",
        "run",
        "--launch-profile",
        "https"
      ],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch-wasm",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "--project",
        "${workspaceFolder}/QMS.Wasm/QMS.Wasm.csproj",
        "run",
        "--launch-profile",
        "http"
      ],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    }
  ]
}
